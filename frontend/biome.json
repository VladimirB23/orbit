{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "includes": ["**", "!src/api/schema.d.ts", "!openapi.json", "!package-lock.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": { "enabled": false }
    },
    {
      "includes": [
        "src/features/tree/tree-view.tsx",
        "src/features/tree/tree-row.tsx",
        "src/features/tree/row-parts.tsx",
        "src/features/tree/cells.tsx",
        "src/features/tree/columns.tsx",
        "src/features/tree/use-row-keys.ts",
        "src/features/timeline/**"
      ],
      "linter": {
        "rules": {
          "a11y": { "useSemanticElements": "off", "useFocusableInteractive": "off" },
          "correctness": { "noComponentHookFactories": "off" }
        }
      }
    }
  ]
}
