#!/bin/sh
# Every check of the project in one command; stops at the first failure. --fast skips the browser.
# mypy and pytest go through python -m: Smart App Control may block the .exe launchers of uv.
set -e
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/backend"
uv run --quiet ruff check .
uv run --quiet ruff format --check .
uv run --quiet python -m mypy
uv run --quiet python -m pytest
cd "$root/frontend"
npm run --silent check
if [ "$1" != "--fast" ]; then npm run --silent e2e; fi
echo "All checks passed."
